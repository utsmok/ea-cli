+class StagedCopyrightItem(Model, TimestampMixin):
+    """
+    Staging table for raw data ingested from copyright export files.
+    Fields are kept as simple as possible to accommodate raw data.
+
+    The raw fields we expect:
+        [
+        "Material id",
+        "Period",
+        "Department",
+        "Course code",
+        "Course name",
+        "url",
+        "Filename",
+        "Title",
+        "Owner",
