+        "Type",
+        "ML Prediction",
+        "Manual classification",
+        "Manual identifier",
+        "Scope",
+        "Remarks",
+        "Auditor",
+        "Last change",
+        "Status",
+        "Google search file",
+        "ISBN",
+        "DOI",
+        "In collection",
+        "pagecount",
+        "wordcount",
+        "picturecount",
+        "Author",
+        "Publisher",
+        "Reliability",
+        "Pages * Students",
+        "#students_registered"
+    ]
+
+    Before ingestion, these should be lowercased, spaces replaced with underscores, * replaced with x, and # replaced with count_.
+    e.g. by calling standardize_dataframe in db.base
+
+    """
+
